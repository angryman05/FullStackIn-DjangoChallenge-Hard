# Copiaza acest fisier in .env si completeaza valorile.
# Genereaza o cheie cu:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=schimba-ma
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Celery: True = taskurile ruleaza direct, fara worker (doar pentru teste rapide)
CELERY_EAGER=False
